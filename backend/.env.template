# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------

# Required — get your key at https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# Environment — controls CORS origins and logging
# Use "development" locally to allow localhost origins
# Use "production" on Render (already set in render.yaml)
APP_ENV=development

# Optional — add an extra allowed CORS origin for custom deployments
# FRONTEND_URL=https://your-staging-app.web.app
